# OpenShift AI Configuration
OPENSHIFT_AI_ENDPOINT=https://your-openshift-ai-endpoint.com
OPENSHIFT_AI_TOKEN=your-api-token-here

# Model Endpoints (deployed on OpenShift AI)
MODEL_FP32_ENDPOINT=https://fp32-model-endpoint.com/v1/chat/completions
MODEL_FP16_ENDPOINT=https://fp16-model-endpoint.com/v1/chat/completions
MODEL_INT8_ENDPOINT=https://int8-model-endpoint.com/v1/chat/completions
MODEL_INT4_ENDPOINT=https://int4-model-endpoint.com/v1/chat/completions

# Demo Configuration
SIMULATION_MODE=false
PORT=8000
HOST=0.0.0.0

# Optional: Metrics and Monitoring
ENABLE_PROMETHEUS=true
LOG_LEVEL=INFO

# OpenShift AI Configuration
OPENSHIFT_AI_ENDPOINT=https://your-openshift-ai-endpoint.com
OPENSHIFT_AI_TOKEN=your-api-token-here

# Model Endpoints (deployed on OpenShift AI via vLLM)
# These point to your vLLM model serving endpoints for each variant.
MODEL_FP16_ENDPOINT=https://fp16-llama70b.apps.your-cluster.com/v1/chat/completions
MODEL_INT4_ENDPOINT=https://int4-llama70b.apps.your-cluster.com/v1/chat/completions
MODEL_SPEC_DECODE_ENDPOINT=https://specdec-llama70b.apps.your-cluster.com/v1/chat/completions

# Demo Configuration
SIMULATION_MODE=true
PORT=8000
HOST=0.0.0.0

# Optional
ENABLE_PROMETHEUS=true
LOG_LEVEL=INFO

# -------------------------------------------------------------------
# Smaller GPU Option (Llama 8B)
# -------------------------------------------------------------------
# If you don't have H200s or large GPUs, you can run this demo with
# Llama 3.3 8B instead of 70B. The demo works exactly the same way,
# just swap your model endpoints below. Llama 8B fits on a single
# consumer GPU (A10, L4, T4, or even a 3090).
#
# MODEL_FP16_ENDPOINT=https://fp16-llama8b.apps.your-cluster.com/v1/chat/completions
# MODEL_INT4_ENDPOINT=https://int4-llama8b.apps.your-cluster.com/v1/chat/completions
# MODEL_SPEC_DECODE_ENDPOINT=https://specdec-llama8b.apps.your-cluster.com/v1/chat/completions
#
# For speculative decoding with 8B, use a smaller draft model like
# TinyLlama 1.1B or Llama 3.2 1B as the speculative model in vLLM:
#   python -m vllm.entrypoints.openai.api_server \
#     --model meta-llama/Llama-3.3-8B-Instruct \
#     --speculative-model meta-llama/Llama-3.2-1B-Instruct \
#     --num-speculative-tokens 5

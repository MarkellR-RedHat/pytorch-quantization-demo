# ------------------------------------------------------------------
# Mode
# ------------------------------------------------------------------
# true = numbers sampled from benchmark_results.json, no GPUs needed
SIMULATION_MODE=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Protects the Ask box and the controls. Open the dashboard once with /presenter?key=<value>
# and the browser keeps a cookie. Leave empty only on your laptop.
PRESENTER_KEY=
# Set true behind the OpenShift router so the presenter cookie is marked secure over HTTPS
TRUST_PROXY=false

# ------------------------------------------------------------------
# Live mode: vLLM OpenAI-compatible chat completions endpoints
# ------------------------------------------------------------------
# Bearer token, only if the endpoints need one
OPENSHIFT_AI_TOKEN=
MODEL_BF16_ENDPOINT=https://bf16-llama70b.apps.your-cluster.com/v1/chat/completions
MODEL_INT4_ENDPOINT=https://int4-llama70b.apps.your-cluster.com/v1/chat/completions
MODEL_SPEC_DECODE_ENDPOINT=https://specdec-llama70b.apps.your-cluster.com/v1/chat/completions
# Optional fourth variant; leave empty to hide it
MODEL_FP8_ENDPOINT=
# Served model names (vLLM --served-model-name); default is the variant key lowercased
MODEL_BF16_NAME=
MODEL_INT4_NAME=
MODEL_SPEC_DECODE_NAME=
MODEL_FP8_NAME=
# Backup switch per setup: "recorded" never calls that endpoint and plays the preset recordings,
# labeled "Recorded <date>". On Oct 20 (5 H200s) the plan is BF16, spec decode and FP8 live and
# INT4 recorded:
#   MODEL_FP8_ENDPOINT=http://localhost:18004/v1/chat/completions
#   MODEL_FP8_NAME=benchmark-fp8
#   MODEL_INT4_MODE=recorded
#   MODEL_INT4_CAPTURES=INT4_RH
MODEL_BF16_MODE=live
MODEL_INT4_MODE=live
MODEL_SPEC_DECODE_MODE=live
# Which recordings the INT4 column uses: INT4 (community AWQ build) or INT4_RH (Red Hat's LLM
# Compressor build, the one on stage). Match it to MODEL_INT4_NAME.
MODEL_INT4_CAPTURES=INT4_RH

# Label for the unquantized baseline. Llama 3.1 ships in bfloat16 and vLLM keeps it with --dtype auto.

# ------------------------------------------------------------------
# Traffic, protection, cost
# ------------------------------------------------------------------
AUTO_TRAFFIC=true
AUTO_TRAFFIC_RPS=0.5
MAX_INFLIGHT_PER_VARIANT=32
# Hourly price of ONE GPU in USD. 0 hides cost on the dashboard.
GPU_HOURLY_USD=0
# Latency target for the load test: tail time per output token in ms (20 tokens/s per user at 50)
TPOT_TARGET_MS=50

# ------------------------------------------------------------------
# Smaller GPU option (Llama 3.1 8B)
# ------------------------------------------------------------------
# The 70B setup benchmarked on H200s (args from kubernetes/models/isvc-spec-decode.yaml):
#   vllm serve meta-llama/Meta-Llama-3.1-70B-Instruct --tensor-parallel-size 2 \
#     --dtype bfloat16 --max-model-len 131072 \
#     --speculative-config '{"model": "meta-llama/Llama-3.1-8B-Instruct", "num_speculative_tokens": 5}'
# Untested smaller version: Llama 3.1 8B at BF16 with Llama 3.2 1B as the draft on one 24 GB GPU
# (A10, L4, 3090). It needs a shorter context to fit:
#   vllm serve meta-llama/Llama-3.1-8B-Instruct --max-model-len 8192 \
#     --speculative-config '{"model": "meta-llama/Llama-3.2-1B-Instruct", "num_speculative_tokens": 5}'

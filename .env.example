# Copy to .env. Every setting has a default; replay mode needs none of them.

SIMULATION_MODE=true
PRESENTER_KEY=

# vLLM chat completions endpoints and served names (--served-model-name); live mode only
MODEL_BF16_ENDPOINT=http://localhost:18001/v1/chat/completions
MODEL_BF16_NAME=benchmark-bf16
MODEL_SPEC_DECODE_ENDPOINT=http://localhost:18003/v1/chat/completions
MODEL_SPEC_DECODE_NAME=benchmark-spec
MODEL_FP8_ENDPOINT=http://localhost:18004/v1/chat/completions
MODEL_FP8_NAME=benchmark-fp8
MODEL_INT4_ENDPOINT=http://localhost:18002/v1/chat/completions
MODEL_INT4_NAME=benchmark-int4-rh
# Bearer token, only if the endpoints need one
OPENSHIFT_AI_TOKEN=

# live (default) or recorded: a recorded setup never calls its endpoint and plays its recordings
MODEL_BF16_MODE=live
MODEL_SPEC_DECODE_MODE=live
MODEL_FP8_MODE=live
MODEL_INT4_MODE=live
# Which recordings the INT4 column plays: INT4_RH (Red Hat's W4A16 build) or INT4 (the AWQ build)
MODEL_INT4_CAPTURES=INT4_RH

# Which track starts on screen: llama (default) or qwen. Q on the presenter switches between tracks
# that have data; a track whose files haven't landed is refused unless ALLOW_PENDING_TRACKS=true.
TRACK=llama
ALLOW_PENDING_TRACKS=false

# Concurrent live requests per setup before extra ones get an instant "busy"
MAX_INFLIGHT_PER_VARIANT=32
# Latency target for the load test, tail time per output token in ms (20 tokens/s per user at 50)
TPOT_TARGET_MS=50
# Hourly price of one GPU in USD; 0 hides cost on the dashboard
GPU_HOURLY_USD=0
# Set when the app runs behind a proxy that sets X-Forwarded-For
TRUST_PROXY=false
